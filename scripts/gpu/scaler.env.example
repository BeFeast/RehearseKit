# Environment for `rk gpu-scaler` (systemd: ~/.config/rk/scaler.env, mode 0600).
# Every value can also be passed as a flag; run `rk gpu-scaler -h`.

# rk serve as reachable from THIS host (the scaler polls the queue here and
# the reverse tunnel forwards to it).
RK_API_URL=http://10.10.0.15:30080
# Same secret as RK_RUNNER_TOKEN on the server; handed to the rented runner.
RK_RUNNER_TOKEN=change-me
# Optional: lets the scaler read the queue from Postgres while the server
# still predates GET /api/v1/gpu/queue. Read-only queries.
#RK_DATABASE_URL=postgres://user:pass@10.10.0.15:65430/rehearsekit_v2

# Policy (defaults shown).
#RK_SCALER_INTERVAL=30s
#RK_SCALER_IDLE=10m
#RK_SCALER_MAX_AGE=6h
#RK_SCALER_BOOT_TIMEOUT=15m
#RK_SCALER_RENT_COOLDOWN=2m
#RK_SCALER_MIN_CREDIT=5

# What to rent.
#RK_SCALER_IMAGE=ghcr.io/kossoy/rk-gpu-runner:latest
#RK_SCALER_OFFER_QUERY=gpu_ram>=12 num_gpus=1 dph<0.35 reliability>0.95 inet_down>200 disk_space>=30 cuda_vers>=12.1 rentable=true
#RK_SCALER_DISK=30
#RK_SCALER_LABEL=rk-gpu-scaler
# Extra runner env, e.g. for GPUs with < 8 GB: RK_SCALER_RUNNER_ENV=-e RK_DEMUCS_ARGS=--segment 7
#RK_SCALER_RUNNER_ENV=

# Registry login for a private image: taken from ~/.docker/config.json
# (inline auth) unless one of these is set.
#RK_SCALER_DOCKER_CONFIG=/home/me/.docker/config.json
#RK_SCALER_DOCKER_LOGIN=-u user -p token ghcr.io

# Tunnel: port bound on the instance loopback (the runner's RK_API_URL is
# http://127.0.0.1:<port>) and where it forwards to (default: host of RK_API_URL).
#RK_SCALER_TUNNEL_PORT=18080
#RK_SCALER_TUNNEL_TARGET=10.10.0.15:30080
#RK_SCALER_SSH_KEY=/home/me/.ssh/id_ed25519
# Set when rk serve is reachable from the internet and no tunnel is needed.
#RK_SCALER_NO_TUNNEL=1

# vast.ai: the CLI's own key file (~/.config/vastai/vast_api_key) is used
# unless one of these is set.
#VAST_API_KEY_FILE=/home/me/.config/vastai/vast_api_key
#VAST_API_KEY=

#RK_SCALER_STATE_DIR=/home/me/.local/state/rk-gpu-scaler
#RK_LOG_LEVEL=debug
